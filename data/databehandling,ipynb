   "id": "8656c94c",
   "metadata": {},
   "outputs": [],
   "source": [
    "controls = read_control_events(sessionpath)\n",
    "#timestamp,source,action,details"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "4e7e7a0f",
   "metadata": {},
   "outputs": [],
   "source": [
    "P_toggleon_timestamps = controls[(controls.action == \"on\") & (controls.source == \"PELTIER_SWITCH\")]\n",
    "P_toggleoff_timestamps = controls[(controls.action == \"off\") & (controls.source == \"PELTIER_SWITCH\")]\n",
    "P_toggleheat_timestamps = controls[(controls.action == \"heat\") & (controls.source == \"POLARITY\")]\n",
    "P_togglecool_timestamps = controls[(controls.action == \"cool\") & (controls.source == \"POLARITY\")]\n",
    "\n",
    "events = controls[\n",
    "    ((controls.source == \"PELTIER_SWITCH\") & controls.action.isin([\"on\", \"off\"])) |\n",
    "    ((controls.source == \"POLARITY\") & controls.action.isin([\"cool\", \"heat\"]))\n",
    "].sort_values(\"timestamp\")\n",
    "\n",
    "Peltier_event_on_and_cooling = []\n",
    "Peltier_event_on_and_heating = []\n",
    "\n",
    "p_on = False\n",
    "mode = None\n",
    "active_start = None\n",
    "\n",
    "for _, row in events.iterrows():\n",
    "    ts = row[\"timestamp\"]\n",
    "    action = row[\"action\"]\n",
    "\n",
    "    if active_start is not None and (action == \"off\" or action in (\"cool\", \"heat\")):\n",
    "        if mode == \"cool\":\n",
    "            Peltier_event_on_and_cooling.append((active_start, ts))\n",
    "        elif mode == \"heat\":\n",
    "            Peltier_event_on_and_heating.append((active_start, ts))\n",
    "        active_start = None\n",
    "\n",
    "    if action == \"on\":\n",
    "        p_on = True\n",
    "    elif action == \"off\":\n",
    "        p_on = False\n",
    "    elif action in (\"cool\", \"heat\"):\n",
    "        mode = action\n",
    "\n",
    "    if active_start is None and p_on and mode in (\"cool\", \"heat\"):\n",
    "        active_start = ts\n",
    "\n",
    "\n",
    "USB_RELAY_event_ontimes = controls[(controls.source == \"USB_RELAY\") & (controls.action == \"on\")].copy()\n",
    "USB_RELAY_event_offtimes = controls[(controls.source == \"USB_RELAY\") & (controls.action == \"off\")].copy()\n",
    "\n",
    "usb_events = controls[\n",
    "    (controls.source == \"USB_RELAY\") & controls.action.isin([\"on\", \"off\"])\n",
    "].copy()\n",
    "\n",
    "usb_events[\"relay\"] = usb_events[\"details\"].str.extract(r\"relay=(\\d+)\").astype(float).astype(\"Int64\")\n",
    "usb_events = usb_events.sort_values(\"timestamp\")\n",
    "\n",
    "USB_RELAY_on_intervals = {}\n",
    "usb_active_starts = {}\n",
    "\n",
    "for _, row in usb_events.iterrows():\n",
    "    ts = row[\"timestamp\"]\n",
    "    action = row[\"action\"]\n",
    "    relay = row[\"relay\"]\n",
    "\n",
    "    if pd.isna(relay):\n",
    "        continue\n",
    "\n",
    "    relay = int(relay)\n",
    "\n",
    "    if relay not in USB_RELAY_on_intervals:\n",
    "        USB_RELAY_on_intervals[relay] = []\n",
    "\n",
    "    if action == \"on\":\n",
    "        usb_active_starts[relay] = ts\n",
    "    elif action == \"off\" and relay in usb_active_starts:\n",
    "        USB_RELAY_on_intervals[relay].append((usb_active_starts[relay], ts))\n",
    "        del usb_active_starts[relay]\n"
   ]
  },
  {
