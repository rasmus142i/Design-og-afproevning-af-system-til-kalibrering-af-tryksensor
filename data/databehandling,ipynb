   "source": [
    "dFLf = read_and_fix_fluke(sessionpath)\n",
    "\n",
    "T3c = hmmm[\"T3\"][\"Temperature\"]\n",
    "T3mask = (T3c > 0) & (T3c < 50)\n",
    "T3m = T3c[T3mask]\n",
    "T3mx = hmmm[\"T3\"][\"Timestamp\"][T3mask]\n",
    "\n",
    "T2c = hmmm[\"T2\"][\"Temperature\"]\n",
    "T2mask = (T2c > 0) & (T2c < 50)\n",
    "T2m = T2c[T2mask]\n",
    "T2mx = hmmm[\"T2\"][\"Timestamp\"][T2mask]\n",
    "\n",
    "Pm = dFLf[\"Pressure\"]\n",
    "Pmask = (Pm > 0) & (Pm < 75)\n",
    "Pm = Pm[Pmask]\n",
    "Pmx = dFLf[\"Time\"][Pmask]\n",
    "\n",
    "Vc = (hmmm[\"V\"][\"Voltage\"])\n",
    "Vmask = (Vc > -200) & (Vc < 200)\n",
    "Vm = Vc[Vmask]\n",
    "Vmx = hmmm[\"V\"][\"Timestamp\"][Vmask]"
   ]
  },
  {
   "cell_type": "code",
