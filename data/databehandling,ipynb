   "metadata": {},
   "outputs": [],
   "source": [
    "tseries = np.linspace(np.min([T3mx.min(), T2mx.min(), Pmx.min(), Vmx.min()]), np.max([T3mx.max(), T2mx.max(), Pmx.max(), Vmx.max()]), 1000)\n",
    "T3i, T2i, Pi, Vi = [np.interp(tseries, Yx, Y) for Yx, Y in [(T3mx, T3m), (T2mx, T2m), (Pmx, Pm), (Vmx, Vm)]]\n",
    "Ti = np.mean((T3i, T2i), axis=0)"
   ]
