   "source": [
    "fig, axes = plt.subplots(3, figsize=(10, 8))\n",
    "for i, t in enumerate((\"T2\", \"T3\", \"T4\")):\n",
    "    axes[i].plot(hmmm[t][\"Timestamp\"], hmmm[t][\"Temperature\"], label=f\"{t}\")\n",
